#!/bin/bash

# 飞牛应用环境变量
APP_ROOT="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
PID_FILE="${DATA_DIR}/app.pid"
LOG_DIR="${DATA_DIR}/logs"
LOG_FILE="${LOG_DIR}/app.log"

# 优先使用套件内置 Node，其次官方依赖包 nodejs_v24
resolve_node_bin() {
    if [ -x "${APP_ROOT}/runtime/bin/node" ]; then
        printf "%s" "${APP_ROOT}/runtime/bin/node"
        return 0
    fi
    if [ -x "/var/apps/nodejs_v24/target/bin/node" ]; then
        printf "%s" "/var/apps/nodejs_v24/target/bin/node"
        return 0
    fi
    if [ -x "/var/apps/nodejs_v22/target/bin/node" ]; then
        printf "%s" "/var/apps/nodejs_v22/target/bin/node"
        return 0
    fi
    return 1
}

log_msg() {
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

write_user_error() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    mkdir -p "${DATA_DIR}/data" 2>/dev/null || true
    mkdir -p "${LOG_DIR}" 2>/dev/null || true

    if status; then
        log_msg "Process already running."
        return 0
    fi

    NODE_BIN="$(resolve_node_bin)" || {
        log_msg "Node binary not found (runtime/bin/node or system nodejs_v24)."
        write_user_error "应用启动失败：未找到 Node.js 运行时。"
        return 1
    }

    if [ ! -f "${APP_ROOT}/www/server/index.mjs" ]; then
        log_msg "Missing app entry: ${APP_ROOT}/www/server/index.mjs"
        write_user_error "应用启动失败：未找到服务端入口文件。"
        return 1
    fi

    log_msg "Using Node: ${NODE_BIN}"
    log_msg "Starting MediaHub..."

    (
        cd "${APP_ROOT}/www/server" || exit 1
        export NODE_ENV=production
        export TRIM_PKGVAR="${DATA_DIR}"
        export TRIM_PKGDIR="${APP_ROOT}"
        export TRIM_APPDEST="${APP_ROOT}"
        # 飞牛授权目录：启动时落盘 + 透传环境变量
        # 运行中变更由 config_callback 更新落盘文件，Node 侧热读文件无需重启
        export TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
        printf "%s" "${TRIM_DATA_ACCESSIBLE_PATHS}" > "${DATA_DIR}/accessible_paths.env" 2>/dev/null || true
        chmod 600 "${DATA_DIR}/accessible_paths.env" 2>/dev/null || true
        export NITRO_PRESET=node-server
        export PORT="${TRIM_SERVICE_PORT:-3030}"
        exec -a "MediaHub" "${NODE_BIN}" "${APP_ROOT}/www/server/index.mjs"
    ) >> "${LOG_FILE}" 2>&1 &

    printf "%s" "$!" > "${PID_FILE}"
    return 0
}

stop_process() {
    log_msg "Stopping MediaHub..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi

        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ ${count} -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done

        if check_process "${pid}"; then
            kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        fi

        rm -f "${PID_FILE}"
    fi

    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac