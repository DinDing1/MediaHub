# fnOS package scripts must use LF
deploy/fnos/mediahub/cmd/* text eol=lf
deploy/fnos/mediahub/config/* text eol=lf
deploy/fnos/mediahub/wizard/* text eol=lf
deploy/fnos/mediahub/manifest text eol=lf
.github/workflows/*.yml text eol=lf

# Source text: UTF-8, normalize EOL in repo
* text=auto eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.html text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.fpk binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
