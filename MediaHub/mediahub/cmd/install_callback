#!/bin/bash

### This script is called after the user installs the application.

# 创建应用数据目录（如果环境变量已设置）
if [ -n "${TRIM_PKGVAR}" ]; then
    mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null
    mkdir -p "${TRIM_PKGVAR}/logs" 2>/dev/null
fi

# 保存安装向导中的自定义媒体路径
if [ -n "${wizard_media_path}" ] && [ -n "${TRIM_PKGVAR}" ]; then
    echo "${wizard_media_path}" > "${TRIM_PKGVAR}/data/media_path.conf" 2>/dev/null
fi

exit 0
